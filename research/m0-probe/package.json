{
  "name": "drift-m0-probe",
  "version": "0.1.0",
  "private": true,
  "description": "Drift Milestone 0: records SmartSpectra face signals (blink, validation codes, landmarks) to test whether sustained eye closure can be detected.",
  "main": "main.js",
  "scripts": {
    "build": "esbuild renderer.js --bundle --outfile=dist/renderer.bundle.js --platform=browser --format=iife --log-level=warning",
    "start": "npm run build && electron .",
    "analyze": "node analyze.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.5.0"
  },
  "devDependencies": {
    "electron": "^43.8.1",
    "esbuild": "^0.25.0"
  }
}
