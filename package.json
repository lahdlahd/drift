{
  "name": "drift",
  "productName": "Drift",
  "version": "0.1.0",
  "private": true,
  "description": "A lecture player that pauses when you doze off or step away, using Presage SmartSpectra face signals from your webcam.",
  "license": "MIT",
  "main": "build/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@smartspectra/node-sdk": "3.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "43.8.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0",
    "vitest": "^5.1.1"
  },
  "author": "Joel (Lahd) <iamlahdlahd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/lahdlahd/drift.git"
  },
  "homepage": "https://github.com/lahdlahd/drift#readme"
}
